# PineTree Wallet Dynamic External JWT / BYOA placeholders.
# Generate real values with:
# npm run dynamic:jwt:generate

NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=<from Dynamic dashboard>
NEXT_PUBLIC_PINETREE_DYNAMIC_AUTH_MODE=external_jwt
NEXT_PUBLIC_PINETREE_DYNAMIC_EMAIL_FALLBACK=false

# Server-only bearer token for authenticated maintenance endpoints.
CRON_SECRET=<generate a strong random server-only secret>

DYNAMIC_EXTERNAL_JWT_ENABLED=true
DYNAMIC_EXTERNAL_JWT_ISSUER=https://app.pinetree-payments.com
# Audience is NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID. Set an override only if
# Dynamic support explicitly requires a different value.
DYNAMIC_EXTERNAL_JWT_AUDIENCE_OVERRIDE=
DYNAMIC_EXTERNAL_JWT_KID=<generated kid>
DYNAMIC_EXTERNAL_JWT_SIGNING_KEY_B64=<server-only generated base64 signing key>

# Speed Custom Connect / managed Lightning
SPEED_API_KEY=<Speed platform API key>
SPEED_WEBHOOK_SECRET=<Speed account-level webhook secret>
SPEED_CONNECT_WEBHOOK_SECRET=<Speed connected-account webhook secret>
SPEED_CONNECT_ENABLED=false
SPEED_API_BASE_URL=https://api.tryspeed.com
SPEED_ENVIRONMENT=test
PINE_TREE_LIGHTNING_PROVIDER=speed
PINE_TREE_LIGHTNING_SETTLEMENT_MODE=speed_merchant_account

# Unified Speed Custom Connect password. Server-only, never returned to the
# browser, logged, or stored in Supabase. Required when SPEED_CONNECT_ENABLED
# is true. See docs/environment/speed-credentials-env-checklist.md.
SPEED_CONNECTED_ACCOUNT_PASSWORD=<server-only Speed account password>
# Legacy admin recovery only. Preserve the original 64-char hex key anywhere
# historical merchant_speed_credentials rows must remain decryptable.
SPEED_CREDENTIAL_ENCRYPTION_KEY=

# Automatic Lightning sweep (Speed Custom Connect balance -> PineTree Wallet
# BOLT11 invoice via Speed Instant Send). Server-only - never prefix with
# NEXT_PUBLIC_. See docs/environment/lightning-sweep-env-checklist.md.
# Must be exactly "true" to allow ANY outbound Speed Instant Send call.
SPEED_LIGHTNING_SWEEP_ENABLED=false
# Speed's confirmed endpoints are /balances, /balance-transactions, and
# /send. Merchant calls use the server-resolved acct_ identifier in the
# canonical `speed-account` header; no endpoint/header override is accepted.
SPEED_SWEEP_MIN_SATS=1
SPEED_SWEEP_FEE_RESERVE_SATS=0
SPEED_SWEEP_MAX_ATTEMPTS=5
SPEED_SWEEP_RETRY_BASE_SECONDS=30

# Shift4 Payment Platform REST API (retail + e-commerce).
# Server-only - never prefix any of these with NEXT_PUBLIC_.
# Values are supplied by Shift4 and entered directly in the deployment
# environment. Leave every placeholder below blank in the repository.
# See docs/environment/shift4-rest-env-checklist.md.
#
# Must be exactly "test" (api.shift4test.com) or "production"
# (api.shift4api.net). There is no default - an unset value fails closed.
SHIFT4_REST_ENVIRONMENT=
# "host_direct" or "commerce_engine_cloud". Defaults to host_direct.
SHIFT4_REST_INTEGRATION_METHOD=
# The certified Client GUID supplied by the Shift4 API Analyst. Permanent and
# identical across test and production. Never merchant-configurable.
SHIFT4_CLIENT_GUID=
# Interface identity headers. Max lengths 25 / 11 / 26. These may not contain
# $ % : ^ - ~ ` < > , ? " ' { } [ ] \ + =
SHIFT4_INTERFACE_NAME=
SHIFT4_INTERFACE_VERSION=
SHIFT4_COMPANY_NAME=
# 64-char hex (32 bytes). Encrypts stored merchant access tokens and keys the
# invoice derivation. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Do NOT rotate while any Shift4 payment attempt is unsettled - invoice numbers
# are derived from this key and must stay stable for timeout recovery.
SHIFT4_CREDENTIAL_ENCRYPTION_KEY=
# The single PineTree administrator allowed to see or use the Shift4 sandbox
# operator tools in /dashboard/admin. Server-only - never prefix with
# NEXT_PUBLIC_, and never commit the real address.
# Access requires BOTH the existing admin role AND an exact match against this
# account's confirmed primary email (compared after trim + lowercase). Missing
# or blank fails closed and the tools disappear entirely.
# Required whenever SHIFT4_REST_ENABLED=true.
SHIFT4_OPERATOR_EMAIL=
# Optional Global Timer overrides in milliseconds. Shift4 documents 120000 for
# UTG/Commerce Engine PIN pad entry and 65000 for other card entry.
SHIFT4_DEVICE_GLOBAL_TIMER_MS=
SHIFT4_GLOBAL_TIMER_MS=
SHIFT4_LOOKUP_TIMEOUT_MS=

# Connected-account balances, transaction sync, and user-triggered Lightning
# withdrawals are active whenever Speed and Connect are configured. Speed
# does not expose AutoPayout or AutoSwap APIs; there are intentionally no
# feature flags that can claim those capabilities are available.

# ─── Bridge (by Stripe) ──────────────────────────────────────────────────────
# Bridge is owned by Stripe but is a SEPARATE integration: its own REST API,
# its own API key, its own customer objects, its own KYC/KYB and endorsements,
# and its own webhook signing. A merchant with a Stripe connected account is
# NOT approved by Bridge. Do not reuse any STRIPE_* value here.
#
# Server-only - never prefix any of these with NEXT_PUBLIC_. Leave every
# placeholder blank in the repository.
# See docs/environment/bridge-env-checklist.md.
#
# Must be exactly "sandbox" (api.sandbox.bridge.xyz) or "production"
# (api.bridge.xyz). There is no default - an unset value fails closed, and a
# production deployment can never silently fall back to sandbox.
BRIDGE_ENVIRONMENT=
# The Bridge API key, sent in the documented `Api-Key` request header.
# Sandbox keys come from the Bridge Dashboard API keys page with ?sandbox=true.
BRIDGE_API_KEY=
# Optional explicit base URL override. Leave blank to use the documented host
# for BRIDGE_ENVIRONMENT. If set it must be https and must match the selected
# environment; a production/sandbox host mismatch is rejected, not corrected.
BRIDGE_BASE_URL=
# PEM public key for the Bridge webhook endpoint, copied from the Bridge
# Dashboard (or read via GET /v0/webhooks/{id}). Verifies X-Webhook-Signature.
# Escaped "\n" sequences are accepted and restored. Never returned to a
# browser and never written to the database.
BRIDGE_WEBHOOK_PUBLIC_KEY=
# Where Bridge returns the merchant's browser after the hosted KYB flow. Must
# be https (localhost allowed in development). The redirect is NOT proof of
# approval - approval always comes from a Bridge status lookup or a verified
# Bridge webhook.
BRIDGE_KYC_REDIRECT_URL=
# Optional request timeout in milliseconds. Defaults to 20000. This is a
# PineTree-chosen value for a control-plane call; Bridge publishes no required
# timeout.
BRIDGE_TIMEOUT_MS=
